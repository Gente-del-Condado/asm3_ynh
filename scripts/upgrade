#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Stopping ASM3 and locking scheduled tasks..."
asm3_lock
ynh_systemctl --service="$app" --action=stop
asm3_configure
asm3_sources
ynh_script_progression "Applying and verifying database migrations..."
set +x
printf '%s' "$rescue_password" | ynh_exec_as_app env ASM3_CONF="$install_dir/asm3.conf" PYTHONDONTWRITEBYTECODE=1 python3 "$install_dir/ynh/manage.py" upgrade "$admin"
unset rescue_password
set -x
yunohost service add "$app" --description="Animal Shelter Manager" --log="/var/log/nginx/$domain-error.log"
asm3_start
ynh_config_add_nginx
chmod 600 "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_script_progression "ASM3 upgrade completed"
