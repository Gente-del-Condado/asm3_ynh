#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Deteniendo ASM3 y bloqueando las tareas programadas…"
asm3_lock
ynh_systemctl --service="$app" --action=stop
asm3_configure
asm3_sources
ynh_script_progression "Aplicando y verificando las migraciones de la base de datos…"
set +x
printf '%s' "$rescue_password" | ynh_exec_as_app env ASM3_CONF="$install_dir/asm3.conf" PYTHONDONTWRITEBYTECODE=1 python3 "$install_dir/ynh/manage.py" upgrade "$admin"
unset rescue_password
set -x
yunohost service add "$app" --description="Animal Shelter Manager" --log="/var/log/nginx/$domain-error.log"
asm3_start
set +x
ynh_config_add_nginx > >(asm3_redact_config_log) 2>&1
set -x
chmod 600 "/etc/nginx/conf.d/$domain.d/$app.conf"
asm3_identity_reconcile
ynh_script_progression "Actualización de ASM3 completada"
