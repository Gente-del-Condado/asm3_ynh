#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Cambiando la URL de ASM3…"
asm3_lock
ynh_systemctl --service="$app" --action=stop
asm3_configure
asm3_start
asm3_safe_config ynh_config_change_url_nginx
chmod 600 "/etc/nginx/conf.d/$domain.d/$app.conf"
yunohost service add "$app" --description="Animal Shelter Manager" --log="/var/log/nginx/$domain-error.log"
if [ "$domain" != "$old_domain" ]; then
    # YunoHost guardaría el nuevo dominio al terminar este script.
    # Los mapas de correo lo necesitan ahora para autorizar el remitente app@dominio.
    ynh_app_setting_set --key=domain --value="$domain"
    yunohost tools regen-conf postfix dovecot
fi

asm3_identity_reconcile
ynh_script_progression "Cambio de URL de ASM3 completado"
