#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Eliminando los servicios y la configuración web de ASM3…"
# Bloquea las tareas programadas antes de eliminar sus recursos.
if [ -n "${data_dir:-}" ] && [ -d "$data_dir" ]; then
    asm3_lock
fi
if [ -f "${install_dir:-}/ynh/manage_identity.py" ]; then
    set +x
    ASM3_CONF="$install_dir/asm3.conf" PYTHONDONTWRITEBYTECODE=1 python3 "$install_dir/ynh/manage_identity.py" detach --app "$app" --install-dir "$install_dir"
    set -x
fi
ynh_safe_rm "/etc/cron.d/$app"
ynh_config_remove_systemd
yunohost service remove "$app"
ynh_config_remove_nginx
# El gestor de recursos elimina la base, la cuenta de servicio y el código.
# YunoHost elimina data_dir cuando se solicita --purge.
