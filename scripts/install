#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Preparando la configuración de ASM3 y activando el bloqueo de mantenimiento…"
asm3_lock
asm3_configure
ynh_script_progression "Descargando y preparando la versión de ASM3 fijada en el paquete…"
asm3_sources
ynh_script_progression "Inicializando la base MariaDB de ASM3 y protegiendo las cuentas predeterminadas…"
# Pasa la contraseña por stdin para evitar que figure en la línea de comandos.
set +x
printf '%s' "$rescue_password" | ynh_exec_as_app env ASM3_CONF="$install_dir/asm3.conf" PYTHONDONTWRITEBYTECODE=1 python3 "$install_dir/ynh/manage.py" install "$admin" "$language"
unset rescue_password
set -x
yunohost service add "$app" --description="Animal Shelter Manager" --log="/var/log/nginx/$domain-error.log"
asm3_start
set +x
ynh_config_add_nginx > >(asm3_redact_config_log) 2>&1
set -x
chmod 600 "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_script_progression "Instalación de ASM3 completada"
