#!/bin/bash
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Creando una copia de seguridad de ASM3, sus documentos y su base de datos…"
asm3_lock
# MariaDB guarda registros y documentos en la misma base. La copia SQL incluye ambos.
ynh_mysql_dump_db > db.sql
ynh_backup "$install_dir"
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"
ynh_backup "/etc/cron.d/$app"
# La caché y el bloqueo de data_dir se regeneran al restaurar.
